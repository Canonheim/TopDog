; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Top Dog"
config/description="A physics climbing party game: grab, fling, freeze, and top your pals."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Feel="*res://data/feel.gd"
Wardrobe="*res://core/wardrobe.gd"
Players="*res://core/players.gd"
Sound="*res://core/sound.gd"
Net="*res://net/net.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=20
jolt_physics_3d/simulation/position_steps=16

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=false
2d/default_gravity=980.0
2d/solver/solver_iterations=32
2d/sleep_threshold_linear=0.5
2d/time_before_sleep=1.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/msaa_3d=0
house_ink/profile="stabilized"
limits/global_shader_variables/buffer_size=524288

[shader_globals]

diffuse_curve={
"type": "sampler2D",
"value": "res://shaders/cel/diffuse_curve.tres"
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
outline_width={
"type": "float",
"value": 3.5
}
specular_smoothness={
"type": "float",
"value": 0.05
}
