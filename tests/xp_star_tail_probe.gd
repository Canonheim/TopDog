extends Node
func _ready() -> void:
	get_tree().create_timer(15).timeout.connect(func(): push_error("STAR TAIL TIMEOUT"); get_tree().quit(1))
	var panel=preload("res://ui3d/xp_match_summary.gd").new()
	add_child(panel)
	panel.set_process(false)
	panel._begin_category("FIRST",1500,true)
	panel._feed(.95,0,1500,1500)
	panel._process(0.0)
	assert(not panel._falling_stars.is_empty())
	var airborne: Array = panel._falling_stars.map(func(drop): return drop.node)
	var count=airborne.size()
	panel._end_category(1500)
	assert(panel._falling_stars.size()==count)
	assert(airborne.all(func(star): return star.visible))
	panel._begin_category("SECOND",1500,true)
	panel._feed(0.0,1500,3000,1500)
	assert(panel._falling_stars.size()==count+1)
	assert(airborne.all(func(star): return star.visible))
	panel._final_total=3000
	panel._finish()
	assert(airborne.all(func(star): return star.visible))
	panel._process(panel.STAR_FALL_SECONDS)
	assert(panel._falling_stars.is_empty())
	for star in airborne:
		assert(not star.visible and is_equal_approx(star.position.y,panel.belt.meter_y))
	panel._launch_feed_star(0,0.0)
	panel.hide()
	assert(panel._falling_stars.is_empty())
	assert(panel._feed_stars.all(func(star): return not star.visible))
	print("STAR TAIL PASS: reward-end survival, overlapping categories, summary survival, exact landing, exit cleanup")
	get_tree().quit()
